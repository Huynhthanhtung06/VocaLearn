@model VocaLearn.ViewModels.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div style="display: flex; flex-direction: column; gap: 2rem;">
    <!-- Welcome Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--main-text); margin-bottom: 0.25rem;">
                Welcome back, @(string.IsNullOrWhiteSpace(Model.UserFullName) ? "Learner" : Model.UserFullName)! 👋
            </h1>
            <p style="color: var(--secondary-text); font-size: 0.95rem;">
                Here is your vocabulary learning overview. Keep up the great momentum!
            </p>
        </div>

        <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
            <a asp-controller="Flashcards" asp-action="Index" class="btn-vl btn-vl-accent">
                <i data-lucide="layers" style="width: 17px; height: 17px;"></i>
                <span>Practice Flashcards</span>
            </a>
            <a asp-controller="Quiz" asp-action="Index" class="btn-vl btn-vl-primary">
                <i data-lucide="help-circle" style="width: 17px; height: 17px;"></i>
                <span>Start Quiz</span>
            </a>
        </div>
    </div>

    <!-- Stat Cards Row -->
    <div class="grid-cols-4">
        <!-- Total Vocabulary -->
        <div class="stat-card">
            <div>
                <span class="stat-label">Total Vocabulary</span>
                <div class="stat-value">@Model.TotalVocabulary</div>
                <div style="font-size: 0.8rem; color: var(--muted-text); margin-top: 0.4rem;">
                    In your personal library
                </div>
            </div>
            <div class="stat-icon blue">
                <i data-lucide="book-open"></i>
            </div>
        </div>

        <!-- Words Mastered -->
        <div class="stat-card">
            <div>
                <span class="stat-label">Words Learned</span>
                <div class="stat-value" style="color: var(--success);">@Model.WordsLearned</div>
                <div style="font-size: 0.8rem; color: var(--success); margin-top: 0.4rem; display: flex; align-items: center; gap: 0.25rem;">
                    <i data-lucide="check" style="width: 13px; height: 13px;"></i>
                    <span>@Model.MasteryPercentage% Mastery Rate</span>
                </div>
            </div>
            <div class="stat-icon green">
                <i data-lucide="award"></i>
            </div>
        </div>

        <!-- Words Needing Review -->
        <div class="stat-card">
            <div>
                <span class="stat-label">Need More Practice</span>
                <div class="stat-value" style="color: var(--warning);">@Model.WordsNeedingReview</div>
                <div style="font-size: 0.8rem; color: var(--secondary-text); margin-top: 0.4rem;">
                    Prioritized in review sessions
                </div>
            </div>
            <div class="stat-icon red">
                <i data-lucide="repeat"></i>
            </div>
        </div>

        <!-- Quizzes Completed -->
        <div class="stat-card">
            <div>
                <span class="stat-label">Quizzes Completed</span>
                <div class="stat-value" style="color: var(--accent-cyan);">@Model.TotalQuizzesCompleted</div>
                <div style="font-size: 0.8rem; color: var(--accent-cyan); margin-top: 0.4rem;">
                    Avg Score: @Model.AverageQuizScore%
                </div>
            </div>
            <div class="stat-icon cyan">
                <i data-lucide="trophy"></i>
            </div>
        </div>
    </div>

    <!-- Charts Row -->
    <div class="grid-cols-2">
        <!-- Daily Activity Chart -->
        <div class="vl-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 class="card-title">Learning Activity</h2>
                    <p class="card-subtitle">Daily words reviewed and quizzes completed over the last 7 days</p>
                </div>
                <span class="badge-vl badge-learning">Last 7 Days</span>
            </div>
            <div style="height: 270px; position: relative;">
                <canvas id="activityChart"></canvas>
            </div>
        </div>

        <!-- Vocabulary Status Distribution -->
        <div class="vl-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 class="card-title">Vocabulary Status</h2>
                    <p class="card-subtitle">Distribution of words by mastery level</p>
                </div>
                <span class="badge-vl badge-learned">Overview</span>
            </div>
            <div style="height: 270px; display: flex; align-items: center; justify-content: center; position: relative;">
                <canvas id="statusChart"></canvas>
            </div>
        </div>
    </div>

    <!-- Bottom Lists: Recent Words & Recent Quizzes -->
    <div class="grid-cols-2">
        <!-- Recent Vocabulary -->
        <div class="vl-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 class="card-title">Recent Vocabulary</h2>
                    <p class="card-subtitle">Recently reviewed and added words</p>
                </div>
                <a asp-controller="Vocabulary" asp-action="Index" class="btn-vl btn-vl-secondary btn-vl-sm">
                    View All
                </a>
            </div>

            @if (!Model.RecentVocabulary.Any())
            {
                <div style="text-align: center; padding: 2.5rem 1rem; color: var(--secondary-text);">
                    <i data-lucide="book-open" style="width: 40px; height: 40px; margin-bottom: 0.75rem; opacity: 0.5;"></i>
                    <p>No vocabulary words yet.</p>
                    <a asp-controller="Vocabulary" asp-action="Create" class="btn-vl btn-vl-primary btn-vl-sm" style="margin-top: 0.75rem;">
                        Add Your First Word
                    </a>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var word in Model.RecentVocabulary)
                    {
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1rem; background-color: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 10px;">
                            <div style="display: flex; align-items: center; gap: 0.85rem;">
                                <button type="button" class="speak-btn" style="width: 34px; height: 34px; font-size: 0.8rem;" onclick="speakWord('@word.Word')" title="Listen pronunciation">
                                    <i data-lucide="volume-2" style="width: 15px; height: 15px;"></i>
                                </button>
                                <div>
                                    <div style="font-weight: 700; color: var(--main-text); font-size: 1rem;">@word.Word</div>
                                    <div style="font-size: 0.85rem; color: var(--secondary-text);">@word.Meaning</div>
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 0.5rem;">
                                @if (word.Status == VocabularyStatus.Learned)
                                {
                                    <span class="badge-vl badge-learned">Learned</span>
                                }
                                else if (word.Status == VocabularyStatus.Learning)
                                {
                                    <span class="badge-vl badge-learning">Learning</span>
                                }
                                else if (word.NeedsPractice || word.Status == VocabularyStatus.NeedsReview)
                                {
                                    <span class="badge-vl badge-needsreview">Practice</span>
                                }
                                else
                                {
                                    <span class="badge-vl badge-notlearned">New</span>
                                }

                                <a asp-controller="Vocabulary" asp-action="Details" asp-route-id="@word.Id" style="color: var(--secondary-text); padding: 0.25rem;">
                                    <i data-lucide="chevron-right" style="width: 16px; height: 16px;"></i>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <!-- Recent Quiz Results -->
        <div class="vl-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 class="card-title">Recent Quiz Results</h2>
                    <p class="card-subtitle">Your latest quiz scores and accuracy</p>
                </div>
                <a asp-controller="Quiz" asp-action="History" class="btn-vl btn-vl-secondary btn-vl-sm">
                    View History
                </a>
            </div>

            @if (!Model.RecentQuizzes.Any())
            {
                <div style="text-align: center; padding: 2.5rem 1rem; color: var(--secondary-text);">
                    <i data-lucide="help-circle" style="width: 40px; height: 40px; margin-bottom: 0.75rem; opacity: 0.5;"></i>
                    <p>No quizzes taken yet.</p>
                    <a asp-controller="Quiz" asp-action="Index" class="btn-vl btn-vl-primary btn-vl-sm" style="margin-top: 0.75rem;">
                        Take a Quiz
                    </a>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 0.75rem;">
                    @foreach (var quiz in Model.RecentQuizzes)
                    {
                        var isPassing = quiz.ScorePercentage >= 80;
                        <div style="display: flex; align-items: center; justify-content: space-between; padding: 0.85rem 1rem; background-color: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color); border-radius: 10px;">
                            <div>
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <span style="font-weight: 700; color: var(--main-text);">@quiz.QuizMode</span>
                                    <span style="font-size: 0.75rem; color: var(--muted-text);">• @quiz.CompletedAt.ToString("MMM dd, HH:mm")</span>
                                </div>
                                <div style="font-size: 0.825rem; color: var(--secondary-text); margin-top: 0.2rem;">
                                    @(quiz.Category != null ? quiz.Category.Name : "All Categories") • @quiz.CorrectAnswers / @quiz.TotalQuestions correct
                                </div>
                            </div>

                            <div style="display: flex; align-items: center; gap: 0.75rem;">
                                <span style="font-size: 1.15rem; font-weight: 800; color: @(isPassing ? "var(--success)" : "var(--accent-cyan)");">
                                    @quiz.ScorePercentage%
                                </span>
                                <a asp-controller="Quiz" asp-action="Result" asp-route-id="@quiz.Id" class="btn-vl btn-vl-secondary btn-vl-sm">
                                    Review
                                </a>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        // Chart.js Theme Defaults
        Chart.defaults.color = '#94A3B8';
        Chart.defaults.font.family = "'Inter', sans-serif";

        // 1. Learning Activity Chart (Bar)
        const ctxActivity = document.getElementById('activityChart');
        if (ctxActivity) {
            new Chart(ctxActivity, {
                type: 'bar',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityDates)),
                    datasets: [
                        {
                            label: 'Words Reviewed',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityReviewedWords)),
                            backgroundColor: 'rgba(59, 130, 246, 0.7)',
                            borderColor: '#3B82F6',
                            borderWidth: 1,
                            borderRadius: 6
                        },
                        {
                            label: 'Quizzes Taken',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityQuizzesTaken)),
                            backgroundColor: 'rgba(56, 189, 248, 0.7)',
                            borderColor: '#38BDF8',
                            borderWidth: 1,
                            borderRadius: 6
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, padding: 15 } }
                    },
                    scales: {
                        x: { grid: { color: 'rgba(255, 255, 255, 0.05)' } },
                        y: { 
                            beginAtZero: true, 
                            ticks: { precision: 0 },
                            grid: { color: 'rgba(255, 255, 255, 0.05)' } 
                        }
                    }
                }
            });
        }

        // 2. Vocabulary Status Chart (Doughnut)
        const ctxStatus = document.getElementById('statusChart');
        if (ctxStatus) {
            new Chart(ctxStatus, {
                type: 'doughnut',
                data: {
                    labels: ['Learned', 'In Learning', 'Needs Practice', 'Not Learned'],
                    datasets: [{
                        data: [@Model.WordsLearned, @Model.WordsLearning, @Model.WordsNeedingReview, @Model.WordsNotLearned],
                        backgroundColor: [
                            '#22C55E', // success green
                            '#38BDF8', // cyan
                            '#EF4444', // red
                            '#64748B'  // muted slate
                        ],
                        borderWidth: 2,
                        borderColor: '#17243A'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    cutout: '72%',
                    plugins: {
                        legend: { position: 'bottom', labels: { boxWidth: 12, padding: 14 } }
                    }
                }
            });
        }
    });
</script>
}
