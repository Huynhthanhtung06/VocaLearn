@model VocaLearn.ViewModels.ProfileViewModel
@{
    ViewData["Title"] = "Account Settings";
}

<div style="max-width: 860px; margin: 0 auto;">
    <div style="margin-bottom: 2rem;">
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--main-text); margin-bottom: 0.5rem;">Account Settings</h1>
        <p style="color: var(--secondary-text);">Manage your personal profile, security and preferences.</p>
    </div>

    <!-- Quick Stats -->
    <div class="grid-cols-3" style="margin-bottom: 2rem;">
        <div class="vl-card" style="padding: 1.25rem;">
            <div style="font-size: 0.825rem; color: var(--secondary-text);">Total Words</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--accent-cyan); margin-top: 0.25rem;">@Model.TotalWords</div>
        </div>
        <div class="vl-card" style="padding: 1.25rem;">
            <div style="font-size: 0.825rem; color: var(--secondary-text);">Words Mastered</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--success); margin-top: 0.25rem;">@Model.WordsLearned</div>
        </div>
        <div class="vl-card" style="padding: 1.25rem;">
            <div style="font-size: 0.825rem; color: var(--secondary-text);">Quizzes Completed</div>
            <div style="font-size: 1.75rem; font-weight: 800; color: var(--primary-blue); margin-top: 0.25rem;">@Model.QuizzesCompleted</div>
        </div>
    </div>

    <div class="grid-cols-2">
        <!-- Edit Profile -->
        <div class="vl-card">
            <h2 class="card-title" style="margin-bottom: 1.25rem;">Personal Profile</h2>

            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label asp-for="FullName" class="form-label">Full Name</label>
                    <input asp-for="FullName" class="form-control-vl" />
                    <span asp-validation-for="FullName" style="color: var(--error); font-size: 0.8rem;"></span>
                </div>

                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input type="email" value="@Model.Email" class="form-control-vl" disabled style="opacity: 0.7; cursor: not-allowed;" />
                    <small style="color: var(--muted-text); font-size: 0.775rem;">Email cannot be changed.</small>
                </div>

                <div class="form-group">
                    <label class="form-label">Member Since</label>
                    <input type="text" value="@Model.JoinedDate.ToString("MMMM dd, yyyy")" class="form-control-vl" disabled style="opacity: 0.7;" />
                </div>

                <button type="submit" class="btn-vl btn-vl-primary">
                    <i data-lucide="save" style="width: 16px; height: 16px;"></i>
                    <span>Save Changes</span>
                </button>
            </form>
        </div>

        <!-- Security -->
        <div class="vl-card">
            <h2 class="card-title" style="margin-bottom: 0.5rem;">Password & Security</h2>
            <p style="color: var(--secondary-text); font-size: 0.9rem; margin-bottom: 1.5rem;">
                Keep your account secure with a strong password.
            </p>

            <a asp-action="ChangePassword" class="btn-vl btn-vl-secondary" style="margin-bottom: 1.5rem; display: inline-flex;">
                <i data-lucide="key" style="width: 16px; height: 16px;"></i>
                <span>Change Password</span>
            </a>

            <div style="padding: 1.25rem; border-radius: 10px; background-color: rgba(255, 255, 255, 0.02); border: 1px solid var(--border-color);">
                <div style="font-weight: 600; font-size: 0.9rem; margin-bottom: 0.35rem; color: var(--main-text);">Data Privacy</div>
                <p style="font-size: 0.825rem; color: var(--secondary-text); line-height: 1.5;">
                    Your vocabulary list, flashcard reviews and quiz results are completely private and only accessible through your personal account.
                </p>
            </div>
        </div>
    </div>
</div>
