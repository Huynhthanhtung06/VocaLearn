@model VocaLearn.ViewModels.ChangePasswordViewModel
@{
    ViewData["Title"] = "Change Password";
}

<div style="max-width: 520px; margin: 0 auto;">
    <div style="margin-bottom: 2rem;">
        <a asp-action="Profile" class="btn-vl btn-vl-secondary btn-vl-sm" style="margin-bottom: 1rem; display: inline-flex;">
            <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
            <span>Back to Settings</span>
        </a>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--main-text); margin-bottom: 0.5rem;">Change Password</h1>
        <p style="color: var(--secondary-text);">Update your account password</p>
    </div>

    <div class="vl-card">
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert-vl alert-vl-danger" style="margin-bottom: 1.5rem;">
                <div asp-validation-summary="All"></div>
            </div>
        }

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="CurrentPassword" class="form-label">Current Password</label>
                <input asp-for="CurrentPassword" class="form-control-vl" placeholder="••••••••" />
                <span asp-validation-for="CurrentPassword" style="color: var(--error); font-size: 0.8rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword" class="form-label">New Password</label>
                <input asp-for="NewPassword" class="form-control-vl" placeholder="Minimum 6 characters" />
                <span asp-validation-for="NewPassword" style="color: var(--error); font-size: 0.8rem;"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmNewPassword" class="form-label">Confirm New Password</label>
                <input asp-for="ConfirmNewPassword" class="form-control-vl" placeholder="Re-type new password" />
                <span asp-validation-for="ConfirmNewPassword" style="color: var(--error); font-size: 0.8rem;"></span>
            </div>

            <button type="submit" class="btn-vl btn-vl-primary" style="width: 100%; margin-top: 0.5rem;">
                Update Password
            </button>
        </form>
    </div>
</div>
