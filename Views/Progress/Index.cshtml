@model VocaLearn.ViewModels.ProgressAnalyticsViewModel
@{
    ViewData["Title"] = "Learning Progress & Analytics";
}

<div style="display: flex; flex-direction: column; gap: 2rem;">
    <!-- Page Header -->
    <div>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--main-text); margin-bottom: 0.25rem;">
            Learning Progress & Analytics
        </h1>
        <p style="color: var(--secondary-text);">
            Real-time mastery tracking, recall performance, and study history.
        </p>
    </div>

    <!-- Stat Highlights -->
    <div class="grid-cols-4">
        <div class="stat-card">
            <div>
                <span class="stat-label">Mastery Rate</span>
                <div class="stat-value" style="color: var(--success);">@Model.MasteryPercentage%</div>
                <div style="font-size: 0.8rem; color: var(--secondary-text); margin-top: 0.4rem;">
                    @Model.WordsLearned of @Model.TotalVocabulary words mastered
                </div>
            </div>
            <div class="stat-icon green">
                <i data-lucide="award"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <span class="stat-label">Words in Practice</span>
                <div class="stat-value" style="color: var(--warning);">@Model.WordsNeedingReview</div>
                <div style="font-size: 0.8rem; color: var(--secondary-text); margin-top: 0.4rem;">
                    Require additional recall cycles
                </div>
            </div>
            <div class="stat-icon red">
                <i data-lucide="repeat"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <span class="stat-label">Average Quiz Score</span>
                <div class="stat-value" style="color: var(--accent-cyan);">@Model.AverageQuizScore%</div>
                <div style="font-size: 0.8rem; color: var(--secondary-text); margin-top: 0.4rem;">
                    Across @Model.TotalQuizzesCompleted quiz sessions
                </div>
            </div>
            <div class="stat-icon cyan">
                <i data-lucide="target"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <span class="stat-label">Questions Answered</span>
                <div class="stat-value" style="color: var(--primary-blue);">@Model.TotalQuestionsAnswered</div>
                <div style="font-size: 0.8rem; color: var(--secondary-text); margin-top: 0.4rem;">
                    @Model.TotalCorrectAnswers correct responses
                </div>
            </div>
            <div class="stat-icon blue">
                <i data-lucide="check-circle-2"></i>
            </div>
        </div>
    </div>

    <!-- Main Charts Row -->
    <div class="grid-cols-2">
        <!-- Weekly Progress Activity Chart -->
        <div class="vl-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 class="card-title">Weekly Activity Trend</h2>
                    <p class="card-subtitle">Daily words learned vs words reviewed</p>
                </div>
                <span class="badge-vl badge-learning">7-Day Analysis</span>
            </div>
            <div style="height: 280px; position: relative;">
                <canvas id="weeklyTrendChart"></canvas>
            </div>
        </div>

        <!-- Mastery by Category -->
        <div class="vl-card">
            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.25rem;">
                <div>
                    <h2 class="card-title">Category Mastery Breakdown</h2>
                    <p class="card-subtitle">Vocabulary retention across topics</p>
                </div>
                <a asp-controller="Category" asp-action="Index" class="btn-vl btn-vl-secondary btn-vl-sm">Manage</a>
            </div>

            @if (!Model.CategoryStats.Any())
            {
                <div style="text-align: center; padding: 2rem; color: var(--secondary-text);">
                    No categories created yet.
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 1.15rem;">
                    @foreach (var cat in Model.CategoryStats)
                    {
                        <div>
                            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.4rem;">
                                <div style="display: flex; align-items: center; gap: 0.5rem;">
                                    <div style="width: 10px; height: 10px; border-radius: 50%; background-color: @cat.CategoryColor;"></div>
                                    <span style="font-weight: 600; color: var(--main-text); font-size: 0.95rem;">@cat.CategoryName</span>
                                </div>
                                <span style="font-size: 0.85rem; font-weight: 700; color: var(--accent-cyan);">
                                    @cat.LearnedWords / @cat.TotalWords words (@cat.MasteryPercentage%)
                                </span>
                            </div>
                            <div class="vl-progress">
                                <div class="vl-progress-fill" style="width: @cat.MasteryPercentage%; background: @cat.CategoryColor;"></div>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>

    <!-- Quiz History Section -->
    <div class="vl-card">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
            <div>
                <h2 class="card-title">Completed Quizzes History</h2>
                <p class="card-subtitle">Every assessment taken with your final score and review links</p>
            </div>
            <a asp-controller="Quiz" asp-action="Index" class="btn-vl btn-vl-primary btn-vl-sm">
                <i data-lucide="play" style="width: 14px; height: 14px;"></i>
                <span>Take a Quiz</span>
            </a>
        </div>

        @if (!Model.QuizHistory.Any())
        {
            <div style="text-align: center; padding: 2.5rem 1rem; color: var(--secondary-text);">
                <i data-lucide="help-circle" style="width: 40px; height: 40px; margin-bottom: 0.75rem; opacity: 0.5;"></i>
                <p>No quizzes recorded yet.</p>
            </div>
        }
        else
        {
            <div class="vl-table-container">
                <table class="vl-table">
                    <thead>
                        <tr>
                            <th>Completed Date</th>
                            <th>Quiz Mode</th>
                            <th>Category</th>
                            <th>Accuracy</th>
                            <th>Score</th>
                            <th style="text-align: right;">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var q in Model.QuizHistory.Take(10))
                        {
                            var passed = q.ScorePercentage >= 80;
                            <tr>
                                <td>@q.CompletedAt.ToString("MMM dd, yyyy HH:mm")</td>
                                <td><span class="badge-vl badge-learning">@q.QuizMode</span></td>
                                <td>@(q.Category != null ? q.Category.Name : "All Categories")</td>
                                <td>@q.CorrectAnswers of @q.TotalQuestions</td>
                                <td>
                                    <span style="font-weight: 800; color: @(passed ? "var(--success)" : "var(--accent-cyan)");">
                                        @q.ScorePercentage%
                                    </span>
                                </td>
                                <td style="text-align: right;">
                                    <a asp-controller="Quiz" asp-action="Result" asp-route-id="@q.Id" class="btn-vl btn-vl-secondary btn-vl-sm">
                                        Review
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@section Scripts {
<script>
    document.addEventListener('DOMContentLoaded', function() {
        Chart.defaults.color = '#94A3B8';
        Chart.defaults.font.family = "'Inter', sans-serif";

        const ctxTrend = document.getElementById('weeklyTrendChart');
        if (ctxTrend) {
            new Chart(ctxTrend, {
                type: 'line',
                data: {
                    labels: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyLabels)),
                    datasets: [
                        {
                            label: 'Words Mastered',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyLearnedData)),
                            borderColor: '#22C55E',
                            backgroundColor: 'rgba(34, 197, 94, 0.1)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2,
                            pointBackgroundColor: '#22C55E'
                        },
                        {
                            label: 'Words Reviewed',
                            data: @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.WeeklyReviewedData)),
                            borderColor: '#38BDF8',
                            backgroundColor: 'rgba(56, 189, 248, 0.1)',
                            fill: true,
                            tension: 0.35,
                            borderWidth: 2,
                            pointBackgroundColor: '#38BDF8'
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'top', labels: { boxWidth: 12, padding: 15 } }
                    },
                    scales: {
                        x: { grid: { color: 'rgba(255, 255, 255, 0.05)' } },
                        y: { 
                            beginAtZero: true, 
                            ticks: { precision: 0 },
                            grid: { color: 'rgba(255, 255, 255, 0.05)' } 
                        }
                    }
                }
            });
        }
    });
</script>
}
