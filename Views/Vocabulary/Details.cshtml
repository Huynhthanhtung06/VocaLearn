@model VocaLearn.Models.Vocabulary
@{
    ViewData["Title"] = $"{Model.Word} Details";
    var accuracy = Model.ReviewCount == 0 ? 0 : Math.Round((double)Model.CorrectCount / Model.ReviewCount * 100, 1);
}

<div style="max-width: 680px; margin: 0 auto;">
    <div style="margin-bottom: 2rem;">
        <a asp-action="Index" class="btn-vl btn-vl-secondary btn-vl-sm" style="margin-bottom: 1rem; display: inline-flex;">
            <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
            <span>Back to Library</span>
        </a>
        <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 1rem;">
            <div>
                <div style="display: flex; align-items: center; gap: 0.85rem;">
                    <h1 style="font-size: 2.25rem; font-weight: 800; color: var(--main-text); margin-bottom: 0;">@Model.Word</h1>
                    <button type="button" class="speak-btn" onclick="speakWord('@Model.Word')" title="Pronounce">
                        <i data-lucide="volume-2" style="width: 18px; height: 18px;"></i>
                    </button>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Pronunciation))
                {
                    <div style="font-family: monospace; font-size: 1.1rem; color: var(--accent-cyan); margin-top: 0.25rem;">
                        @Model.Pronunciation
                    </div>
                }
            </div>

            <div style="display: flex; gap: 0.5rem;">
                <a asp-action="Edit" asp-route-id="@Model.Id" class="btn-vl btn-vl-primary btn-vl-sm">
                    <i data-lucide="edit-3" style="width: 14px; height: 14px;"></i>
                    <span>Edit</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Main Detail Card -->
    <div class="vl-card" style="margin-bottom: 1.5rem;">
        <div style="margin-bottom: 1.5rem;">
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--secondary-text); text-transform: uppercase; letter-spacing: 0.05em;">Vietnamese Meaning</span>
            <div style="font-size: 1.5rem; font-weight: 700; color: var(--main-text); margin-top: 0.25rem;">
                @Model.Meaning
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.Example))
        {
            <div style="margin-bottom: 1.5rem;">
                <span style="font-size: 0.8rem; font-weight: 700; color: var(--secondary-text); text-transform: uppercase; letter-spacing: 0.05em;">Example Sentence</span>
                <div style="font-size: 1.1rem; color: var(--secondary-text); font-style: italic; background-color: rgba(255, 255, 255, 0.02); padding: 1rem 1.25rem; border-radius: 10px; border-left: 3px solid var(--accent-cyan); margin-top: 0.5rem; line-height: 1.6;">
                    "@Model.Example"
                </div>
            </div>
        }

        <div class="grid-cols-2" style="border-top: 1px solid var(--border-color); padding-top: 1.25rem;">
            <div>
                <span style="font-size: 0.8rem; color: var(--secondary-text);">Category</span>
                <div style="margin-top: 0.25rem;">
                    <span style="font-size: 0.85rem; font-weight: 700; color: @(Model.Category?.Color ?? "#3B82F6"); background: rgba(59, 130, 246, 0.1); padding: 0.25rem 0.65rem; border-radius: 6px;">
                        @(Model.Category?.Name ?? "General")
                    </span>
                </div>
            </div>

            <div>
                <span style="font-size: 0.8rem; color: var(--secondary-text);">Status</span>
                <div style="margin-top: 0.25rem;">
                    @if (Model.Status == VocabularyStatus.Learned)
                    {
                        <span class="badge-vl badge-learned">Learned</span>
                    }
                    else if (Model.Status == VocabularyStatus.Learning)
                    {
                        <span class="badge-vl badge-learning">Learning</span>
                    }
                    else if (Model.NeedsPractice || Model.Status == VocabularyStatus.NeedsReview)
                    {
                        <span class="badge-vl badge-needsreview">Need More Practice</span>
                    }
                    else
                    {
                        <span class="badge-vl badge-notlearned">Not Learned</span>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Learning Metrics Card -->
    <div class="vl-card">
        <h3 class="card-title" style="margin-bottom: 1rem;">Memory & Practice History</h3>
        <div class="grid-cols-3">
            <div style="background-color: rgba(255, 255, 255, 0.02); padding: 1rem; border-radius: 10px; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--secondary-text);">Times Reviewed</div>
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--primary-blue); margin-top: 0.25rem;">@Model.ReviewCount</div>
            </div>

            <div style="background-color: rgba(255, 255, 255, 0.02); padding: 1rem; border-radius: 10px; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--secondary-text);">Correct Answers</div>
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--success); margin-top: 0.25rem;">@Model.CorrectCount</div>
            </div>

            <div style="background-color: rgba(255, 255, 255, 0.02); padding: 1rem; border-radius: 10px; border: 1px solid var(--border-color);">
                <div style="font-size: 0.8rem; color: var(--secondary-text);">Accuracy Rate</div>
                <div style="font-size: 1.5rem; font-weight: 800; color: var(--accent-cyan); margin-top: 0.25rem;">@accuracy%</div>
            </div>
        </div>

        <div style="display: flex; justify-content: space-between; font-size: 0.8rem; color: var(--muted-text); margin-top: 1.25rem; border-top: 1px solid var(--border-color); padding-top: 0.75rem;">
            <span>Added: @Model.CreatedAt.ToString("MMM dd, yyyy")</span>
            <span>Last Reviewed: @(Model.LastReviewedAt.HasValue ? Model.LastReviewedAt.Value.ToString("MMM dd, yyyy HH:mm") : "Never")</span>
        </div>
    </div>
</div>
