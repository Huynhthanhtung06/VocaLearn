@model VocaLearn.ViewModels.ExcelImportPreviewViewModel
@{
    ViewData["Title"] = "Preview Imported Vocabulary";
}

<div style="display: flex; flex-direction: column; gap: 2rem;">
    <!-- Header -->
    <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
        <div>
            <a asp-action="Index" class="btn-vl btn-vl-secondary btn-vl-sm" style="margin-bottom: 0.5rem; display: inline-flex;">
                <i data-lucide="arrow-left" style="width: 14px; height: 14px;"></i>
                <span>Upload a different file</span>
            </a>
            <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--main-text); margin-bottom: 0.25rem;">
                Import Preview: @Model.FileName
            </h1>
            <p style="color: var(--secondary-text);">
                Review the parsed rows, duplicate detections and validations before confirming import.
            </p>
        </div>

        <div style="display: flex; gap: 0.75rem;">
            <a asp-action="Index" class="btn-vl btn-vl-secondary">
                Cancel
            </a>
        </div>
    </div>

    <!-- Summary Stats -->
    <div class="grid-cols-4">
        <div class="stat-card">
            <div>
                <span class="stat-label">Total Rows</span>
                <div class="stat-value">@Model.TotalRows</div>
            </div>
            <div class="stat-icon blue">
                <i data-lucide="file-text"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <span class="stat-label">Ready to Import</span>
                <div class="stat-value" style="color: var(--success);">@Model.ValidCount</div>
            </div>
            <div class="stat-icon green">
                <i data-lucide="check"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <span class="stat-label">Duplicates Found</span>
                <div class="stat-value" style="color: var(--warning);">@Model.DuplicateCount</div>
            </div>
            <div class="stat-icon red">
                <i data-lucide="copy"></i>
            </div>
        </div>

        <div class="stat-card">
            <div>
                <span class="stat-label">Invalid Rows</span>
                <div class="stat-value" style="color: var(--error);">@Model.InvalidCount</div>
            </div>
            <div class="stat-icon red">
                <i data-lucide="alert-triangle"></i>
            </div>
        </div>
    </div>

    <!-- Confirmation Form Card -->
    <div class="vl-card" style="padding: 1.5rem; background: linear-gradient(145deg, #16243b, #111b2d); border-color: var(--border-active);">
        <form asp-action="Confirm" method="post" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            @Html.AntiForgeryToken()
            <input type="hidden" name="SerializedRows" value="@Model.SerializedRows" />

            <label style="display: flex; align-items: center; gap: 0.5rem; font-size: 0.95rem; color: var(--main-text); cursor: pointer;">
                <input type="checkbox" name="SkipDuplicates" value="true" checked style="width: 18px; height: 18px; accent-color: var(--primary-blue);" />
                <span>Skip existing duplicate words (Recommended)</span>
            </label>

            <div style="display: flex; gap: 0.75rem;">
                <a asp-action="Index" class="btn-vl btn-vl-secondary">
                    Cancel
                </a>
                <button type="submit" class="btn-vl btn-vl-primary" @(Model.ValidCount == 0 && Model.DuplicateCount == 0 ? "disabled" : "")>
                    <i data-lucide="check" style="width: 17px; height: 17px;"></i>
                    <span>Confirm & Import to Library</span>
                </button>
            </div>
        </form>
    </div>

    <!-- Preview Table -->
    <div class="vl-card">
        <h3 class="card-title" style="margin-bottom: 1.25rem;">Parsed Rows Details</h3>

        <div class="vl-table-container">
            <table class="vl-table">
                <thead>
                    <tr>
                        <th style="width: 60px;">Row</th>
                        <th>English Word</th>
                        <th>Pronunciation</th>
                        <th>Vietnamese Meaning</th>
                        <th>Example Sentence</th>
                        <th>Category</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in Model.Rows)
                    {
                        <tr>
                            <td>#@row.RowIndex</td>
                            <td>
                                <strong style="color: var(--main-text);">@row.Word</strong>
                            </td>
                            <td style="font-family: monospace; color: var(--accent-cyan);">@(string.IsNullOrWhiteSpace(row.Pronunciation) ? "—" : row.Pronunciation)</td>
                            <td>@row.Meaning</td>
                            <td style="font-size: 0.85rem; color: var(--secondary-text); font-style: italic; max-width: 250px;">
                                @(string.IsNullOrWhiteSpace(row.Example) ? "—" : row.Example)
                            </td>
                            <td>
                                <span style="font-size: 0.8rem; background: rgba(59, 130, 246, 0.12); color: var(--accent-cyan); padding: 0.2rem 0.5rem; border-radius: 6px;">
                                    @row.Category
                                </span>
                            </td>
                            <td>
                                @if (!row.IsValid)
                                {
                                    <span class="badge-vl badge-needsreview" title="@row.ErrorMessage">
                                        <i data-lucide="alert-circle" style="width: 12px; height: 12px;"></i>
                                        <span>Invalid</span>
                                    </span>
                                }
                                else if (row.IsDuplicate)
                                {
                                    <span class="badge-vl badge-learning" style="background: rgba(245, 158, 11, 0.12); color: var(--warning); border-color: rgba(245, 158, 11, 0.3);" title="@row.ErrorMessage">
                                        <i data-lucide="copy" style="width: 12px; height: 12px;"></i>
                                        <span>Duplicate</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-vl badge-learned">
                                        <i data-lucide="check" style="width: 12px; height: 12px;"></i>
                                        <span>Valid</span>
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
