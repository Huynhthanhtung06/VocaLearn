@model VocaLearn.ViewModels.QuizSessionViewModel
@{
    ViewData["Title"] = $"{Model.Mode} Quiz";
}

<div style="max-width: 720px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem;">
    <!-- Top Progress Bar & Header -->
    <div style="display: flex; justify-content: space-between; align-items: center;">
        <div>
            <span style="font-size: 0.8rem; font-weight: 700; color: var(--accent-cyan); text-transform: uppercase; letter-spacing: 0.05em;">
                @Model.Mode • @Model.CategoryName • @Model.LessonNames
            </span>
            <div id="quizCounter" style="font-size: 1.25rem; font-weight: 800; color: var(--main-text);">
                Question 1 of @Model.Questions.Count
            </div>
        </div>

        <div style="display: flex; align-items: center; gap: 0.75rem;">
            <div style="text-align: right;">
                <div id="scorePreview" style="font-size: 0.85rem; color: var(--secondary-text);">Score: 0/0</div>
            </div>
            <a asp-action="Index" class="btn-vl btn-vl-secondary btn-vl-sm" onclick="return confirm('Exit this quiz session? Progress will not be saved.');">
                Exit
            </a>
        </div>
    </div>

    <div class="vl-progress">
        <div id="quizProgressBar" class="vl-progress-fill" style="width: 10%;"></div>
    </div>

    <!-- Active Question Card -->
    <div class="vl-card" style="padding: 2.25rem; min-height: 400px; display: flex; flex-direction: column; justify-content: space-between;">
        <!-- Question Prompt Area -->
        <div>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 1rem;">
                <h2 id="qPrompt" style="font-size: 1.5rem; font-weight: 800; color: var(--main-text); line-height: 1.3;">
                    Prompt
                </h2>
                <button type="button" id="qSpeakBtn" class="speak-btn" style="width: 38px; height: 38px; flex-shrink: 0;" onclick="speakPromptWord()" title="Listen audio">
                    <i data-lucide="volume-2" style="width: 18px; height: 18px;"></i>
                </button>
            </div>

            <!-- Context / Sub-prompt -->
            <div id="qSubPrompt" style="font-size: 1rem; color: var(--secondary-text); margin-bottom: 1.5rem; display: none;"></div>

            <!-- Example sentence for Fill In The Blank -->
            <div id="qExampleBox" style="font-size: 1.15rem; color: var(--main-text); background: rgba(59, 130, 246, 0.08); padding: 1.25rem; border-radius: 12px; border-left: 4px solid var(--primary-blue); margin-bottom: 1.5rem; display: none; line-height: 1.6;">
            </div>

            <!-- Hint text -->
            <div id="qHintBox" style="font-size: 0.85rem; color: var(--accent-cyan); margin-bottom: 1.5rem; display: none;"></div>
        </div>

        <!-- Answers Area: Multiple Choice Options OR Translation Input -->
        <div>
            <!-- Options for MC, RMC, FITB -->
            <div id="optionsContainer" style="display: flex; flex-direction: column; gap: 0.75rem;"></div>

            <!-- Input for Translation -->
            <div id="translationInputContainer" style="display: none;">
                <div class="form-group" style="margin-bottom: 1rem;">
                    <label class="form-label">Type the Vietnamese meaning:</label>
                    <input type="text" id="translationInput" class="form-control-vl" placeholder="Nhập nghĩa tiếng Việt..." autocomplete="off" />
                </div>
                <button type="button" id="btnSubmitTranslation" class="btn-vl btn-vl-primary" style="width: 100%;" onclick="submitTranslationAnswer()">
                    Check Translation
                </button>
            </div>

            <!-- Feedback Alert (Shown after answer) -->
            <div id="feedbackBox" style="display: none; margin-top: 1.25rem; padding: 1rem 1.25rem; border-radius: 10px; border: 1px solid transparent;">
                <div style="display: flex; align-items: center; gap: 0.5rem; font-weight: 700; font-size: 1rem;" id="feedbackTitle"></div>
                <div id="feedbackText" style="font-size: 0.9rem; margin-top: 0.35rem; color: var(--main-text);"></div>
            </div>
        </div>

        <!-- Next / Complete Button -->
        <div style="margin-top: 1.5rem; display: flex; justify-content: flex-end;">
            <button type="button" id="btnNextQuestion" class="btn-vl btn-vl-primary" style="display: none;" onclick="goToNextQuestion()">
                <span>Next Question</span>
                <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
            </button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    const questions = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Questions));
    const quizMode = @((int)Model.Mode);
    const categoryId = @(Model.CategoryId.HasValue ? Model.CategoryId.Value.ToString() : "null");

    let currentQIndex = 0;
    let answeredCurrent = false;
    let totalCorrect = 0;
    const recordedAnswers = [];
    let quizAudioContext;

    function playQuizSound(type) {
        try {
            const AudioContextType = window.AudioContext || window.webkitAudioContext;
            if (!AudioContextType) return;
            quizAudioContext ??= new AudioContextType();
            const audioContext = quizAudioContext;
            if (audioContext.state === 'suspended') audioContext.resume();

            const patterns = {
                choose: [
                    { frequency: 740, delay: 0, duration: 0.09, volume: 0.045 },
                    { frequency: 988, delay: 0.035, duration: 0.12, volume: 0.025 }
                ],
                correct: [
                    { frequency: 523.25, delay: 0, duration: 0.2 },
                    { frequency: 659.25, delay: 0.09, duration: 0.22 },
                    { frequency: 783.99, delay: 0.18, duration: 0.32 }
                ],
                incorrect: [
                    { frequency: 392, delay: 0, duration: 0.22, waveform: 'sine', volume: 0.055 },
                    { frequency: 329.63, delay: 0.13, duration: 0.3, waveform: 'sine', volume: 0.05 }
                ],
                happyFinish: [
                    { frequency: 523.25, delay: 0, duration: 0.32 },
                    { frequency: 659.25, delay: 0.13, duration: 0.32 },
                    { frequency: 783.99, delay: 0.26, duration: 0.36 },
                    { frequency: 1046.5, delay: 0.42, duration: 0.55 },
                    { frequency: 659.25, delay: 0.43, duration: 0.42, volume: 0.045 },
                    { frequency: 783.99, delay: 0.43, duration: 0.42, volume: 0.045 }
                ],
                sadFinish: [
                    { frequency: 392, delay: 0, duration: 0.32, waveform: 'sine', volume: 0.055 },
                    { frequency: 349.23, delay: 0.22, duration: 0.34, waveform: 'sine', volume: 0.05 },
                    { frequency: 293.66, delay: 0.46, duration: 0.48, waveform: 'sine', volume: 0.045 }
                ]
            };

            (patterns[type] || []).forEach(note => {
                const startAt = audioContext.currentTime + note.delay;
                const oscillator = audioContext.createOscillator();
                const overtone = audioContext.createOscillator();
                const mainGain = audioContext.createGain();
                const overtoneGain = audioContext.createGain();
                const volume = note.volume ?? 0.065;

                oscillator.type = note.waveform || 'sine';
                oscillator.frequency.setValueAtTime(note.frequency, startAt);
                overtone.type = 'sine';
                overtone.frequency.setValueAtTime(note.frequency * 2.01, startAt);

                mainGain.gain.setValueAtTime(0.001, startAt);
                mainGain.gain.linearRampToValueAtTime(volume, startAt + 0.018);
                mainGain.gain.exponentialRampToValueAtTime(0.001, startAt + note.duration);
                overtoneGain.gain.setValueAtTime(0.001, startAt);
                overtoneGain.gain.linearRampToValueAtTime(volume * 0.22, startAt + 0.012);
                overtoneGain.gain.exponentialRampToValueAtTime(0.001, startAt + note.duration * 0.72);

                oscillator.connect(mainGain);
                overtone.connect(overtoneGain);
                mainGain.connect(audioContext.destination);
                overtoneGain.connect(audioContext.destination);
                oscillator.start(startAt);
                overtone.start(startAt);
                oscillator.stop(startAt + note.duration + 0.02);
                overtone.stop(startAt + note.duration + 0.02);
            });
        } catch (error) {
            console.warn('Quiz audio is unavailable.', error);
        }
    }

    function loadQuestion(index) {
        if (index >= questions.length) {
            finalizeQuiz();
            return;
        }

        answeredCurrent = false;
        const q = questions[index];

        // Header & Progress
        document.getElementById('quizCounter').textContent = `Question ${index + 1} of ${questions.length}`;
        const pct = Math.round(((index + 1) / questions.length) * 100);
        document.getElementById('quizProgressBar').style.width = `${pct}%`;
        document.getElementById('scorePreview').textContent = `Score: ${totalCorrect}/${index}`;

        // Prompt
        document.getElementById('qPrompt').textContent = q.Prompt;

        // SubPrompt
        const subPromptEl = document.getElementById('qSubPrompt');
        if (q.SubPrompt) {
            subPromptEl.textContent = q.SubPrompt;
            subPromptEl.style.display = 'block';
        } else {
            subPromptEl.style.display = 'none';
        }

        // Example With Blank
        const exampleEl = document.getElementById('qExampleBox');
        if (q.ExampleWithBlank) {
            exampleEl.textContent = q.ExampleWithBlank;
            exampleEl.style.display = 'block';
        } else {
            exampleEl.style.display = 'none';
        }

        // Hint Box
        const hintEl = document.getElementById('qHintBox');
        if (q.Hint) {
            hintEl.textContent = q.Hint;
            hintEl.style.display = 'block';
        } else {
            hintEl.style.display = 'none';
        }

        // Reset Feedback and Next button
        document.getElementById('feedbackBox').style.display = 'none';
        document.getElementById('btnNextQuestion').style.display = 'none';

        // Options or Input
        const optionsContainer = document.getElementById('optionsContainer');
        const translationContainer = document.getElementById('translationInputContainer');

        if (quizMode === 4) { // Translation
            optionsContainer.style.display = 'none';
            translationContainer.style.display = 'block';
            const input = document.getElementById('translationInput');
            input.value = '';
            input.disabled = false;
            document.getElementById('btnSubmitTranslation').disabled = false;
            input.focus();
        } else {
            translationContainer.style.display = 'none';
            optionsContainer.style.display = 'flex';
            optionsContainer.innerHTML = '';

            q.Options.forEach((opt, optIdx) => {
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'quiz-option-btn';
                btn.innerHTML = `
                    <span><strong>${String.fromCharCode(65 + optIdx)}.</strong> ${opt}</span>
                    <i data-lucide="circle" style="width: 16px; height: 16px; opacity: 0.5;"></i>
                `;
                btn.onclick = () => selectOption(btn, opt, q);
                optionsContainer.appendChild(btn);
            });
        }

        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function speakPromptWord() {
        const q = questions[currentQIndex];
        // If question prompt has quotes, extract target word
        const match = q.Prompt.match(/["']([^"']+)["']/);
        if (match && match[1]) {
            speakWord(match[1]);
        } else {
            speakWord(q.CorrectAnswer);
        }
    }

    function selectOption(selectedBtn, chosenAnswer, q) {
        if (answeredCurrent) return;
        answeredCurrent = true;

        const isCorrect = chosenAnswer.trim().toLowerCase() === q.CorrectAnswer.trim().toLowerCase();
        playQuizSound('choose');
        playQuizSound(isCorrect ? 'correct' : 'incorrect');
        if (isCorrect) totalCorrect++;

        // Mark buttons
        const allBtns = document.querySelectorAll('.quiz-option-btn');
        allBtns.forEach(btn => {
            btn.disabled = true;
            const text = btn.innerText.replace(/^[A-D]\.\s*/, '').trim();
            if (text.toLowerCase() === q.CorrectAnswer.trim().toLowerCase()) {
                btn.classList.add('correct');
                const icon = btn.querySelector('i, svg');
                if (icon) icon.setAttribute('data-lucide', 'check-circle');
            } else if (btn === selectedBtn && !isCorrect) {
                btn.classList.add('incorrect');
                const icon = btn.querySelector('i, svg');
                if (icon) icon.setAttribute('data-lucide', 'x-circle');
            }
        });

        // Record Answer
        recordedAnswers.push({
            VocabularyId: q.VocabularyId,
            QuestionText: q.Prompt,
            UserAnswer: chosenAnswer,
            CorrectAnswer: q.CorrectAnswer,
            Explanation: isCorrect ? `Correct! Answer is ${q.CorrectAnswer}.` : `Incorrect. Correct answer is ${q.CorrectAnswer}.`
        });

        showFeedback(isCorrect, q.CorrectAnswer);
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function submitTranslationAnswer() {
        if (answeredCurrent) return;
        const input = document.getElementById('translationInput');
        const userAnswer = input.value.trim();
        if (!userAnswer) {
            input.focus();
            return;
        }

        answeredCurrent = true;
        input.disabled = true;
        document.getElementById('btnSubmitTranslation').disabled = true;

        const q = questions[currentQIndex];
        // Evaluation logic
        const lowerUser = userAnswer.toLowerCase();
        const lowerCorrect = q.CorrectAnswer.toLowerCase();
        const parts = lowerCorrect.split(/[,;\/]/).map(s => s.trim());
        const isCorrect = (lowerUser === lowerCorrect) || parts.some(p => p === lowerUser || lowerUser.includes(p) || p.includes(lowerUser));

        playQuizSound('choose');
        playQuizSound(isCorrect ? 'correct' : 'incorrect');
        if (isCorrect) totalCorrect++;

        recordedAnswers.push({
            VocabularyId: q.VocabularyId,
            QuestionText: q.Prompt,
            UserAnswer: userAnswer,
            CorrectAnswer: q.CorrectAnswer,
            Explanation: isCorrect ? `Great! Correct meaning is ${q.CorrectAnswer}.` : `Incorrect. Expected: ${q.CorrectAnswer}.`
        });

        showFeedback(isCorrect, q.CorrectAnswer);
    }

    function showFeedback(isCorrect, correctAnswer) {
        const fbBox = document.getElementById('feedbackBox');
        const fbTitle = document.getElementById('feedbackTitle');
        const fbText = document.getElementById('feedbackText');

        if (isCorrect) {
            fbBox.style.backgroundColor = 'rgba(34, 197, 94, 0.12)';
            fbBox.style.borderColor = 'rgba(34, 197, 94, 0.3)';
            fbTitle.style.color = '#22C55E';
            fbTitle.innerHTML = '<i data-lucide="check-circle" style="width: 20px; height: 20px;"></i> Correct!';
            fbText.textContent = `Well done! Correct answer: ${correctAnswer}`;
        } else {
            fbBox.style.backgroundColor = 'rgba(239, 68, 68, 0.12)';
            fbBox.style.borderColor = 'rgba(239, 68, 68, 0.3)';
            fbTitle.style.color = '#EF4444';
            fbTitle.innerHTML = '<i data-lucide="x-circle" style="width: 20px; height: 20px;"></i> Incorrect';
            fbText.textContent = `The correct answer is: ${correctAnswer}`;
        }

        fbBox.style.display = 'block';

        const nextBtn = document.getElementById('btnNextQuestion');
        nextBtn.style.display = 'inline-flex';
        nextBtn.querySelector('span').textContent = (currentQIndex === questions.length - 1) ? 'View Results' : 'Next Question';
        if (typeof lucide !== 'undefined') lucide.createIcons();
    }

    function goToNextQuestion() {
        currentQIndex++;
        loadQuestion(currentQIndex);
    }

    async function finalizeQuiz() {
        const scorePercent = recordedAnswers.length ? totalCorrect / recordedAnswers.length * 100 : 0;
        playQuizSound(scorePercent > 50 ? 'happyFinish' : 'sadFinish');
        await new Promise(resolve => window.setTimeout(resolve, 1150));

        // Submit payload to backend
        try {
            const response = await fetch('@Url.Action("Submit", "Quiz")', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({
                    Mode: quizMode,
                    CategoryId: categoryId,
                    Answers: recordedAnswers
                })
            });

            const data = await response.json();
            if (data.success && data.redirectUrl) {
                window.location.href = data.redirectUrl;
            } else {
                alert('Quiz completed! Redirecting...');
                window.location.href = '@Url.Action("History", "Quiz")';
            }
        } catch (e) {
            console.error('Error saving quiz results:', e);
            window.location.href = '@Url.Action("Index", "Quiz")';
        }
    }

    // Enter key for translation
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Enter' && quizMode === 4 && !answeredCurrent) {
            e.preventDefault();
            submitTranslationAnswer();
        } else if (e.key === 'Enter' && answeredCurrent) {
            e.preventDefault();
            goToNextQuestion();
        }
    });

    document.addEventListener('DOMContentLoaded', function() {
        loadQuestion(0);
    });
</script>
}
