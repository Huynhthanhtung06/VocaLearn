@model VocaLearn.ViewModels.ListeningIndexViewModel
@{
    ViewData["Title"] = "Listening Practice";
}

<div style="max-width: 900px; margin: 0 auto; display: flex; flex-direction: column; gap: 1.5rem;">
    <header>
        <h1 style="font-size: 1.85rem; font-weight: 800; color: var(--main-text); margin-bottom: 0.25rem;">Listening Practice</h1>
        <p style="color: var(--secondary-text);">Upload listening audio and its question sheet, then practice with the built-in player.</p>
    </header>

    <section class="vl-card" style="padding: 1.5rem;">
        <h2 class="card-title" style="margin-bottom: 1rem;">Add a listening exercise</h2>
        @if (!ViewData.ModelState.IsValid)
        {
            <div asp-validation-summary="All" class="alert-vl alert-vl-danger" style="margin-bottom: 1rem;"></div>
        }
        <form asp-action="Upload" method="post" enctype="multipart/form-data">
            @Html.AntiForgeryToken()
            <div class="form-group">
                <label asp-for="Upload.Title" class="form-label">Exercise title</label>
                <input asp-for="Upload.Title" class="form-control-vl" placeholder="Example: Lesson 1 - At the restaurant" maxlength="150" required />
                <span asp-validation-for="Upload.Title" style="color: var(--error);"></span>
            </div>

            <div class="form-group">
                <label asp-for="Upload.Description" class="form-label">Instructions / description (optional)</label>
                <textarea asp-for="Upload.Description" class="form-control-vl" rows="3" maxlength="1000" placeholder="Add a short note about this listening exercise"></textarea>
            </div>

            <div class="form-group">
                <label asp-for="Upload.AudioFile" class="form-label">Listening audio (required)</label>
                <input asp-for="Upload.AudioFile" type="file" class="form-control-vl" accept=".mp3,.wav,.ogg,.m4a,.wma,audio/*" required />
                <small style="color: var(--secondary-text);">MP3, WAV, OGG, M4A, or WMA; maximum 20 MB. WMA playback depends on browser support.</small>
                <span asp-validation-for="Upload.AudioFile" style="display: block; color: var(--error);"></span>
            </div>

            <div class="form-group" style="margin-bottom: 1.25rem;">
                <label asp-for="Upload.QuestionFile" class="form-label">Multiple-choice question file (optional)</label>
                <input asp-for="Upload.QuestionFile" type="file" class="form-control-vl" accept=".xlsx" />
                <small style="display: block; color: var(--secondary-text);">Upload the provided XLSX template (maximum 8 MB). The website will turn each row into an A/B/C/D question.</small>
                <a asp-action="DownloadQuestionTemplate" class="btn-vl btn-vl-secondary btn-vl-sm" style="margin-top: 0.6rem; display: inline-flex;">
                    <i data-lucide="download" style="width: 14px; height: 14px;"></i>
                    <span>Download question template</span>
                </a>
                <span asp-validation-for="Upload.QuestionFile" style="display: block; color: var(--error);"></span>
            </div>

            <button type="submit" class="btn-vl btn-vl-primary">
                <i data-lucide="upload" style="width: 17px; height: 17px;"></i>
                <span>Save listening exercise</span>
            </button>
        </form>
    </section>

    <section>
        <h2 class="card-title" style="margin-bottom: 1rem;">My listening exercises</h2>
        @if (Model.Lessons.Count == 0)
        {
            <div class="vl-card" style="padding: 2rem; text-align: center; color: var(--secondary-text);">
                No listening exercises yet. Add an audio file above to get started.
            </div>
        }
        else
        {
            <div style="display: grid; gap: 1rem;">
                @foreach (var exercise in Model.Lessons)
                {
                    var lesson = exercise.Lesson;
                    <article class="vl-card" style="padding: 1.25rem;">
                        <h3 style="font-size: 1.15rem; font-weight: 700; color: var(--main-text); margin-bottom: 0.35rem;">@lesson.Title</h3>
                        @if (!string.IsNullOrWhiteSpace(lesson.Description))
                        {
                            <p style="color: var(--secondary-text); margin-bottom: 0.85rem;">@lesson.Description</p>
                        }
                        <audio controls preload="none" src="@Url.Action("Audio", "Listening", new { id = lesson.Id })" style="width: 100%; margin: 0.35rem 0 0.75rem;">
                            Your browser does not support audio playback.
                        </audio>
                        <div style="display: flex; gap: 0.75rem; align-items: center; flex-wrap: wrap;">
                            <span style="font-size: 0.8rem; color: var(--muted-text);">@lesson.AudioOriginalName</span>
                            @if (!string.IsNullOrWhiteSpace(lesson.QuestionStoredName))
                            {
                                <a asp-action="DownloadQuestion" asp-route-id="@lesson.Id" class="btn-vl btn-vl-secondary btn-vl-sm">
                                    <i data-lucide="file-text" style="width: 15px; height: 15px;"></i>
                                    <span>Download question sheet</span>
                                </a>
                            }
                            else
                            {
                                <span style="font-size: 0.85rem; color: var(--muted-text);">No question sheet attached</span>
                            }
                        </div>

                        @if (exercise.Questions.Count > 0)
                        {
                            <div style="border-top: 1px solid var(--border-color); margin-top: 1rem; padding-top: 1rem;">
                                <h4 style="color: var(--main-text); margin-bottom: 0.85rem;">Listening questions (@exercise.Questions.Count)</h4>
                                @for (var questionIndex = 0; questionIndex < exercise.Questions.Count; questionIndex++)
                                {
                                    var question = exercise.Questions[questionIndex];
                                    var options = new[]
                                    {
                                        (Key: "A", Text: question.OptionA),
                                        (Key: "B", Text: question.OptionB),
                                        (Key: "C", Text: question.OptionC),
                                        (Key: "D", Text: question.OptionD)
                                    };
                                    <div class="listening-question" data-correct="@question.CorrectOption" style="padding: 1rem; margin-top: 0.75rem; border-radius: 10px; background: rgba(255,255,255,0.025); border: 1px solid var(--border-color);">
                                        <p style="font-weight: 700; color: var(--main-text); margin-bottom: 0.75rem;">@(questionIndex + 1). @question.Question</p>
                                        @foreach (var option in options)
                                        {
                                            <label style="display: flex; gap: 0.5rem; align-items: flex-start; margin: 0.45rem 0; color: var(--secondary-text); cursor: pointer;">
                                                <input type="radio" name="listen_@(lesson.Id)_@(questionIndex)" value="@option.Key" style="margin-top: 0.25rem; accent-color: var(--primary-blue);" />
                                                <span><strong>@option.Key.</strong> @option.Text</span>
                                            </label>
                                        }
                                        <button type="button" class="btn-vl btn-vl-primary btn-vl-sm" onclick="checkListeningQuestion(this)" style="margin-top: 0.6rem;">Check answer</button>
                                        <p class="listening-answer-feedback" aria-live="polite" style="margin: 0.6rem 0 0; font-weight: 700;"></p>
                                    </div>
                                }
                            </div>
                        }
                    </article>
                }
            </div>

@section Scripts {
    <script>
        function checkListeningQuestion(button) {
            const question = button.closest('.listening-question');
            const selected = question.querySelector('input[type="radio"]:checked');
            const feedback = question.querySelector('.listening-answer-feedback');

            if (!selected) {
                feedback.textContent = 'Choose A, B, C, or D first.';
                feedback.style.color = 'var(--warning)';
                return;
            }

            const isCorrect = selected.value === question.dataset.correct;
            feedback.textContent = isCorrect
                ? 'Correct! Great listening! ??'
                : `Not quite. The correct answer is ${question.dataset.correct}.`;
            feedback.style.color = isCorrect ? 'var(--success)' : 'var(--error)';
            question.querySelectorAll('input[type="radio"]').forEach(input => input.disabled = true);
            button.disabled = true;
        }
    </script>
}
        }
    </section>
</div>
